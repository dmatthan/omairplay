{
  "schemaVersion": 1,
  "id": "io.github.dmatthan.omairplay",
  "name": "OmairPlay",
  "version": "0.9.0",
  "author": "dmatthan",
  "license": "MIT",
  "description": "Turns this machine into an AirPlay speaker. Play from your phone straight to your desktop speakers, with what's playing shown in your bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmairPlay",
    "description": "Receiver on/off, start at login, speaker name, and what the phone is playing.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "speakerName": "Omarchy Speaker",
      "refreshIntervalSec": 5,
      "showArtwork": true,
      "trackNotifications": true
    },
    "schema": [
      {
        "key": "speakerName",
        "type": "string",
        "label": "Speaker name",
        "defaultValue": "Omarchy Speaker"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "showArtwork",
        "type": "boolean",
        "label": "Show cover art",
        "defaultValue": true
      },
      {
        "key": "trackNotifications",
        "type": "boolean",
        "label": "Notify when the track changes",
        "defaultValue": true
      }
    ]
  }
}
