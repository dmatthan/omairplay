#!/bin/bash
# One-time privileged setup, run visibly in Omarchy's floating terminal. Never
# run with pkexec: the user can write this file. Idempotent.
#
# Usage:
#   airplay-setup                 minimal firewall rules (try this first)
#   airplay-setup --wide          also allow LAN-scoped ephemeral TCP and UDP
#   airplay-setup --dry-run       print every command, change nothing
#
# --wide: AirPlay 2 opens its data channels as TCP listeners on ephemeral ports.

set -euo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


WIDE="no"
DRY_RUN="no"
while (( $# )); do
  case "$1" in
    --wide)     WIDE="yes"; shift ;;
    --wide-udp) WIDE="yes"; shift ;;   # old name, kept so notes stay runnable
    --dry-run)  DRY_RUN="yes"; shift ;;
    *) echo "airplay-setup: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$PLUGIN_DIR/bin/airplay-firewall-spec"
STATE_DIR="$HOME/.local/state/io.github.dmatthan.omairplay"
UNIT_DIR="$HOME/.config/systemd/user"
# Anything later executed, or that tells systemd what to execute, is placed
# with this rather than install(1).
INSTALL_FILE="$PLUGIN_DIR/bin/airplay-install-file"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*" >&2; }
fail()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

# Every privileged command goes through here, so --dry-run is honest.
run() {
  printf '\033[36m$ %s\033[0m\n' "$*"
  [[ $DRY_RUN == yes ]] && return 0
  "$@"
}

bold "Omarchy AirPlay receiver setup"
echo

# ---------------------------------------------------------------- safety gate
# One AirPlay 2 slot per machine. The package ships a system and a user
# shairport-sync unit; ours is named differently so it shadows neither.
if systemctl is-enabled shairport-sync.service &>/dev/null \
   || systemctl is-active shairport-sync.service &>/dev/null; then
  fail "The system-wide shairport-sync.service is enabled or running. This
plugin runs a *user* service, and the two would fight over port 7000 and over
the machine's single AirPlay 2 slot. Disable it first:

    sudo systemctl disable --now shairport-sync.service

then run this setup again."
fi

if systemctl --user is-enabled shairport-sync.service &>/dev/null \
   || systemctl --user is-active shairport-sync.service &>/dev/null; then
  fail "The packaged *user* unit shairport-sync.service is enabled or running.
It reads /etc/shairport-sync.conf, which this plugin does not manage, and it
would fight this plugin's receiver over port 7000. Disable it first:

    systemctl --user disable --now shairport-sync.service

then run this setup again."
fi

# ------------------------------------------------------------------- snapshot
# omarchy-snapshot exits 127 without snapper and 1 with no configs: no snapshot.
if command -v omarchy-snapshot >/dev/null; then
  bold "1. System snapshot"
  if ! run omarchy-snapshot create; then
    warn "No snapshot was created (snapper missing or unconfigured)."
    read -rp "Continue without a snapshot? [y/N] " reply
    [[ ${reply,,} == y ]] || fail "Stopped at your request. Nothing was changed."
  fi
else
  warn "omarchy-snapshot not found, so no snapshot was created."
  read -rp "Continue without a snapshot? [y/N] " reply
  [[ ${reply,,} == y ]] || fail "Stopped at your request. Nothing was changed."
fi
echo

# ------------------------------------------------------------------- packages
bold "2. Packages"
if pacman -Q shairport-sync nqptp &>/dev/null; then
  echo "shairport-sync and nqptp are already installed."
else
  # nqptp comes as a dependency; naming it would stop pacman -Rs removing it.
  run omarchy-pkg-add shairport-sync
fi
echo

# ---------------------------------------------------------------------- nqptp
# Binds privileged UDP 319/320, so it has to be a system service.
bold "3. nqptp (system service, needs ports 319 and 320)"
# Record that *we* enabled it, so removal undoes exactly that and nothing more.
if [[ "$(systemctl is-enabled nqptp.service 2>/dev/null)" == "enabled" ]]; then
  echo "nqptp.service was already enabled; leaving that alone."
else
  run sudo systemctl enable nqptp.service
  run "$INSTALL_FILE" --mkdir "$STATE_DIR" 0700
  # Through the installer, not a redirect that would follow a planted symlink.
  # Not piped into `run`: in --dry-run that died of SIGPIPE under pipefail.
  NOTE_LINES=(
    "# OmairPlay enabled nqptp.service on $(date -Is)."
    "# It was not enabled before. airplay-remove disables it again."
  )
  if [[ $DRY_RUN == yes ]]; then
    printf '\033[36m$ %s\033[0m\n' \
      "$INSTALL_FILE <note> $STATE_DIR/enabled-nqptp 0644"
  else
    printf '%s\n' "${NOTE_LINES[@]}" \
      | "$INSTALL_FILE" --stdin "$STATE_DIR/enabled-nqptp" 0644
  fi
fi
if systemctl is-active nqptp.service &>/dev/null; then
  echo "nqptp.service is already running."
else
  run sudo systemctl start nqptp.service
fi
echo

# ------------------------------------------------------------------- firewall
# Local networks only, never Anywhere, never `ufw disable` or `reset`. The rule
# set lives in airplay-firewall-spec.
bold "4. Firewall"

if ! command -v ufw >/dev/null 2>&1; then
  warn "ufw is not installed, so no firewall rules were added."
  warn "If you use another firewall, AirPlay 2 needs TCP 7000, UDP 319, 320"
  warn "and 5353, plus the kernel ephemeral range, reachable from your LAN --"
  warn "over IPv6 as well as IPv4, because iOS will use IPv6 when the router"
  warn "offers it."
else
  mapfile -t GLOBAL_V6 < <(omairplay_global_v6_prefixes)
  if [[ -r /etc/default/ufw ]] && ! grep -qE '^IPV6=yes' /etc/default/ufw; then
    # ufw with IPv6 off does not filter IPv6 at all, so there is nothing to add.
    echo "ufw is not managing IPv6 (IPV6=no in /etc/default/ufw); no IPv6 rules to add."
    GLOBAL_V6=()
    SKIP_V6=yes
  else
    SKIP_V6=no
  fi

  (( ${#GLOBAL_V6[@]} )) && echo "Global IPv6 prefixes: ${GLOBAL_V6[*]}"

  mapfile -t WANTED < <(
    omairplay_rules "$([[ $WIDE == yes ]] && echo yes || echo no)" \
      ${GLOBAL_V6+"${GLOBAL_V6[@]}"}
  )

  # Drop tagged rules this version no longer wants, before adding: ufw ignores
  # duplicates, but nothing else would ever remove a superseded rule.
  mapfile -t STALE < <(omairplay_stale_tagged_rules ${WANTED+"${WANTED[@]}"})
  if (( ${#STALE[@]} )); then
    echo "Removing ${#STALE[@]} rule(s) left by an earlier version."
    for rule in ${STALE+"${STALE[@]}"}; do
      IFS='|' read -r cidr port proto <<<"$rule"
      run sudo ufw --force delete allow from "$cidr" to any port "$port" \
        proto "$proto" || warn "Could not delete the superseded rule for $cidr."
    done
  fi

  added=0
  for rule in ${WANTED+"${WANTED[@]}"}; do
    IFS='|' read -r cidr port proto <<<"$rule"
    [[ -n $cidr ]] || continue
    [[ $cidr == *:* && $SKIP_V6 == yes ]] && continue
    # Tagged, like Omarchy's own installers, so each rule identifies itself.
    run sudo ufw allow from "$cidr" to any port "$port" proto "$proto" \
      comment "$OMAIRPLAY_UFW_COMMENT"
    added=$((added + 1))
  done

  run sudo ufw reload
  echo "$added rule(s) applied, each tagged \"$OMAIRPLAY_UFW_COMMENT\"."
  echo "Review them any time with:  sudo ufw status | grep $OMAIRPLAY_UFW_COMMENT"
fi
echo

# -------------------------------------------------------------- user service
bold "5. Receiver (user service, no root)"

# With the persisted name: after Uninstall the config is gone but the plugin's
# setting is not, and reinstalling must not reset it.
SPEAKER_NAME="$(python3 -I - <<'PYEOF' 2>/dev/null || true
import json, os
path = os.path.expanduser("~/.config/omarchy/shell.json")
try:
    with open(path) as fh:
        config = json.load(fh)
except Exception:
    raise SystemExit(0)
layout = (config.get("bar") or {}).get("layout") or {}
for entries in layout.values():
    for entry in entries or []:
        if isinstance(entry, dict) and entry.get("id") == "io.github.dmatthan.omairplay":
            name = str(entry.get("speakerName") or "").strip()
            if name:
                print(name)
            raise SystemExit(0)
PYEOF
)"

if [[ -n ${SPEAKER_NAME:-} ]]; then
  echo "Using the speaker name from your plugin settings: $SPEAKER_NAME"
  run "$PLUGIN_DIR/bin/airplay-write-config" --name "$SPEAKER_NAME"
else
  run "$PLUGIN_DIR/bin/airplay-write-config"
fi
# Keep a working copy of the uninstaller outside the plugin folder:
# `omarchy plugin remove` deletes a git-managed plugin with no backup.
run "$INSTALL_FILE" --mkdir "$STATE_DIR" 0700
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-remove" "$STATE_DIR/airplay-remove" 0755
# The unit's audio gate lives here too, so the receiver outlives the plugin.
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-wait-audio" "$STATE_DIR/airplay-wait-audio" 0755
# airplay-remove sources the rule spec from its own directory.
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-firewall-spec" "$STATE_DIR/airplay-firewall-spec" 0644

run "$INSTALL_FILE" --mkdir "$UNIT_DIR" 0755
# Verbatim: the unit resolves home itself with %h.
run "$INSTALL_FILE" "$PLUGIN_DIR/share/omarchy-airplay.service" \
  "$UNIT_DIR/omarchy-airplay.service" 0644
run systemctl --user daemon-reload
echo

bold "Setup done."
cat <<EOM

The receiver is installed but not started. Turn it on from the plugin popup,
or by hand with:

    systemctl --user start omarchy-airplay

Then look for "$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*;.*/\1/p' \
  "$HOME/.config/shairport-sync/shairport-sync.conf" 2>/dev/null \
  | head -1)" in the AirPlay list on your phone.

If the speaker appears on the phone but will not connect, the firewall is the
usual reason. Re-run this setup with --wide.

To undo everything later, use "Uninstall" in the plugin popup. A copy of
the uninstaller also lives outside the plugin folder, so it still works if the
plugin itself is removed first:

    $STATE_DIR/airplay-remove --system
EOM
