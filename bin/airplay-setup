#!/bin/bash
# One-time privileged setup for the Omarchy AirPlay receiver plugin.
#
# Runs visibly in Omarchy's floating terminal, which is where a password prompt
# belongs. The plugin itself never needs root at runtime, and never calls this
# with pkexec: the user can write to this file, so running it as root from a
# path the user controls would be a way to escalate.
#
# Idempotent: every step checks before it acts, so re-running is safe.
#
# Usage:
#   airplay-setup                 minimal firewall rules (try this first)
#   airplay-setup --wide          also allow LAN-scoped ephemeral TCP and UDP
#   airplay-setup --dry-run       print every command, change nothing
#
# --wide is needed on this machine. AirPlay 2 opens its data channels as
# *TCP* listeners on kernel ephemeral ports, which nothing narrower covers:
# udp_port_base/udp_port_range are AirPlay 1 only. Confirmed from [UFW BLOCK]
# entries showing the phone's SYNs to ports 50545, 36527, 35193, 37865 and
# 55923 being dropped.

set -euo pipefail

# Re-exec once with a closed environment.
#
# Pinning PATH was not enough. bash reads BASH_ENV for every non-interactive
# script and sources it before the first line here runs, so a hostile value
# executes arbitrary code in this shell -- including defining a function named
# `sudo`, which would then shadow the real command in the privileged steps.
# Unsetting it here cannot help: by then it has already been sourced. The only
# fix is to start again in an environment we built ourselves.
#
# env -i drops everything; what follows is the complete allowlist. It closes
# BASH_ENV and ENV (shell), PYTHONPATH and PYTHONHOME (our python3 helpers),
# LD_PRELOAD and friends (every dynamically linked binary), and CDPATH, IFS and
# GLOBIGNORE (word splitting and `cd`).
#
# The gate is a leading argument, not an environment variable: anything able to
# set a variable could otherwise set the marker and skip the re-exec.
#
# HOME comes from the passwd database rather than the environment. The systemd
# unit resolves its paths with %h, which is the passwd home, so taking it from
# anywhere else let the two disagree -- a user with XDG_CONFIG_HOME set had the
# config written where the receiver would never read it. XDG_* is deliberately
# not carried through, so every path is the one the README documents.
#
# OMARCHY_PATH is set to the value the omarchy package itself hardcodes rather
# than inherited, for the same reason PATH is not inherited.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


WIDE="no"
DRY_RUN="no"
while (( $# )); do
  case "$1" in
    --wide)     WIDE="yes"; shift ;;
    --wide-udp) WIDE="yes"; shift ;;   # old name, kept so notes stay runnable
    --dry-run)  DRY_RUN="yes"; shift ;;
    *) echo "airplay-setup: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$PLUGIN_DIR/bin/airplay-firewall-spec"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/io.github.dmatthan.omairplay"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
# Files that are later executed -- or that tell systemd what to execute --
# are placed with this rather than install(1). See the script for why.
INSTALL_FILE="$PLUGIN_DIR/bin/airplay-install-file"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*" >&2; }
fail()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

# Every privileged command goes through here, so --dry-run is honest and the
# log in NOTES.md can be generated from one place.
run() {
  printf '\033[36m$ %s\033[0m\n' "$*"
  [[ $DRY_RUN == yes ]] && return 0
  "$@"
}

bold "Omarchy AirPlay receiver setup"
echo

# ---------------------------------------------------------------- safety gate
# Safety rule 4: no other shairport-sync may be running. A machine gets exactly
# one AirPlay 2 slot, and two instances would also fight over port 7000.
#
# There are two units to worry about, not one. The Arch package ships both:
#   /usr/lib/systemd/system/shairport-sync.service  (runs as user shairport-sync)
#   /usr/lib/systemd/user/shairport-sync.service    (preset: enabled)
# Ours is omarchy-airplay.service, deliberately named differently so it cannot
# shadow the packaged user unit.
if systemctl is-enabled shairport-sync.service &>/dev/null \
   || systemctl is-active shairport-sync.service &>/dev/null; then
  fail "The system-wide shairport-sync.service is enabled or running. This
plugin runs a *user* service, and the two would fight over port 7000 and over
the machine's single AirPlay 2 slot. Disable it first:

    sudo systemctl disable --now shairport-sync.service

then run this setup again."
fi

if systemctl --user is-enabled shairport-sync.service &>/dev/null \
   || systemctl --user is-active shairport-sync.service &>/dev/null; then
  fail "The packaged *user* unit shairport-sync.service is enabled or running.
It reads /etc/shairport-sync.conf, which this plugin does not manage, and it
would fight this plugin's receiver over port 7000. Disable it first:

    systemctl --user disable --now shairport-sync.service

then run this setup again."
fi

# ------------------------------------------------------------------- snapshot
# Safety rule 2. omarchy-snapshot exits 127 when snapper is absent and 1 when
# snapper is installed but has no configs; both mean "no snapshot was taken".
if command -v omarchy-snapshot >/dev/null; then
  bold "1. System snapshot"
  if ! run omarchy-snapshot create; then
    warn "No snapshot was created (snapper missing or unconfigured)."
    read -rp "Continue without a snapshot? [y/N] " reply
    [[ ${reply,,} == y ]] || fail "Stopped at your request. Nothing was changed."
  fi
else
  warn "omarchy-snapshot not found, so no snapshot was created."
  read -rp "Continue without a snapshot? [y/N] " reply
  [[ ${reply,,} == y ]] || fail "Stopped at your request. Nothing was changed."
fi
echo

# ------------------------------------------------------------------- packages
bold "2. Packages"
if pacman -Q shairport-sync nqptp &>/dev/null; then
  echo "shairport-sync and nqptp are already installed."
else
  # nqptp is a dependency of shairport-sync. Naming it here would mark it as
  # explicitly installed, and pacman -Rs shairport-sync would then leave it.
  run omarchy-pkg-add shairport-sync
fi
echo

# ---------------------------------------------------------------------- nqptp
# nqptp binds UDP 319 and 320, which are privileged ports, so this one really
# does have to be a system service. It carries no audio and exposes no control
# interface. Safety rule 4 allows exactly this.
bold "3. nqptp (system service, needs ports 319 and 320)"
# Record whether *we* enabled it, so removal can undo exactly what setup did
# and nothing more. Without this, removal cannot tell our change from a service
# the user had already enabled for their own reasons -- and guessing, or asking
# them to guess, is worse than keeping a one-line note.
if [[ "$(systemctl is-enabled nqptp.service 2>/dev/null)" == "enabled" ]]; then
  echo "nqptp.service was already enabled; leaving that alone."
else
  run sudo systemctl enable nqptp.service
  run "$INSTALL_FILE" --mkdir "$STATE_DIR" 0700
  # Through the installer rather than a > redirect, which would follow a
  # symlink left at this path and write the note through it.
  #
  # Not piped into `run`: under `set -e -o pipefail`, run returns early in
  # --dry-run without reading stdin, printf dies of SIGPIPE, and the whole
  # pipeline fails at 141 -- which aborted setup. So the two modes are spelt
  # out instead.
  NOTE_LINES=(
    "# OmairPlay enabled nqptp.service on $(date -Is)."
    "# It was not enabled before. airplay-remove disables it again."
  )
  if [[ $DRY_RUN == yes ]]; then
    printf '\033[36m$ %s\033[0m\n' \
      "$INSTALL_FILE <note> $STATE_DIR/enabled-nqptp 0644"
  else
    printf '%s\n' "${NOTE_LINES[@]}" \
      | "$INSTALL_FILE" --stdin "$STATE_DIR/enabled-nqptp" 0644
  fi
fi
if systemctl is-active nqptp.service &>/dev/null; then
  echo "nqptp.service is already running."
else
  run sudo systemctl start nqptp.service
fi
echo

# ------------------------------------------------------------------- firewall
# Safety rule 3: local networks only, never Anywhere, never `ufw disable` or
# `reset`. The rule set itself lives in bin/airplay-firewall-spec so that setup,
# the checker and the remover cannot disagree about it.
bold "4. Firewall"

if ! command -v ufw >/dev/null 2>&1; then
  warn "ufw is not installed, so no firewall rules were added."
  warn "If you use another firewall, AirPlay 2 needs TCP 7000, UDP 319, 320"
  warn "and 5353, plus the kernel ephemeral range, reachable from your LAN --"
  warn "over IPv6 as well as IPv4, because iOS will use IPv6 when the router"
  warn "offers it."
else
  mapfile -t GLOBAL_V6 < <(omairplay_global_v6_prefixes)
  if [[ -r /etc/default/ufw ]] && ! grep -qE '^IPV6=yes' /etc/default/ufw; then
    # ufw with IPv6 off does not manage IPv6 at all: its backend skips the v6
    # chains outright, so it is not filtering IPv6 and there are no v6 rules
    # for it to hold. State the skip plainly rather than warning about a
    # failure that cannot come from here -- if IPv6 is ever blocked by
    # something else, the popup reports the receiver-as-silent symptom.
    echo "ufw is not managing IPv6 (IPV6=no in /etc/default/ufw); no IPv6 rules to add."
    GLOBAL_V6=()
    SKIP_V6=yes
  else
    SKIP_V6=no
  fi

  (( ${#GLOBAL_V6[@]} )) && echo "Global IPv6 prefixes: ${GLOBAL_V6[*]}"

  mapfile -t WANTED < <(
    omairplay_rules "$([[ $WIDE == yes ]] && echo yes || echo no)" \
      ${GLOBAL_V6+"${GLOBAL_V6[@]}"}
  )

  # Drop anything tagged that this version no longer wants, before adding.
  #
  # ufw ignores a duplicate, so re-issuing the wanted set was already
  # idempotent -- but nothing ever removed a rule the spec had dropped. A
  # version that changed the rule set left the superseded ones behind for good,
  # and this plugin is installed and updated through a marketplace, so they
  # accumulate across upgrades. Found by the same tag removal uses, and deleted
  # by rule rather than by number, so there is no renumbering to track.
  mapfile -t STALE < <(omairplay_stale_tagged_rules ${WANTED+"${WANTED[@]}"})
  if (( ${#STALE[@]} )); then
    echo "Removing ${#STALE[@]} rule(s) left by an earlier version."
    for rule in ${STALE+"${STALE[@]}"}; do
      IFS='|' read -r cidr port proto <<<"$rule"
      run sudo ufw --force delete allow from "$cidr" to any port "$port" \
        proto "$proto" || warn "Could not delete the superseded rule for $cidr."
    done
  fi

  added=0
  for rule in ${WANTED+"${WANTED[@]}"}; do
    IFS='|' read -r cidr port proto <<<"$rule"
    [[ -n $cidr ]] || continue
    [[ $cidr == *:* && $SKIP_V6 == yes ]] && continue
    # Tagged with a comment, the way Omarchy's own installers do it, so every
    # rule is self-identifying in `sudo ufw status` -- no record kept on the
    # side, and anyone who finds these rules can see what put them there.
    run sudo ufw allow from "$cidr" to any port "$port" proto "$proto" \
      comment "$OMAIRPLAY_UFW_COMMENT"
    added=$((added + 1))
  done

  run sudo ufw reload
  echo "$added rule(s) applied, each tagged \"$OMAIRPLAY_UFW_COMMENT\"."
  echo "Review them any time with:  sudo ufw status | grep $OMAIRPLAY_UFW_COMMENT"
fi
echo

# -------------------------------------------------------------- user service
bold "5. Receiver (user service, no root)"

# Regenerate the config with the name the plugin has persisted, not the
# generator's default. Setup runs after "Remove receiver" too, and the removal
# deletes the config while leaving the plugin's shell.json entry intact -- so
# without this, reinstalling silently reset the speaker's name to
# "Omarchy Speaker" while the popup's own setting still said something else.
SPEAKER_NAME="$(python3 -I - <<'PYEOF' 2>/dev/null || true
import json, os
path = os.path.expanduser("~/.config/omarchy/shell.json")
try:
    with open(path) as fh:
        config = json.load(fh)
except Exception:
    raise SystemExit(0)
layout = (config.get("bar") or {}).get("layout") or {}
for entries in layout.values():
    for entry in entries or []:
        if isinstance(entry, dict) and entry.get("id") == "io.github.dmatthan.omairplay":
            name = str(entry.get("speakerName") or "").strip()
            if name:
                print(name)
            raise SystemExit(0)
PYEOF
)"

if [[ -n ${SPEAKER_NAME:-} ]]; then
  echo "Using the speaker name from your plugin settings: $SPEAKER_NAME"
  run "$PLUGIN_DIR/bin/airplay-write-config" --name "$SPEAKER_NAME"
else
  run "$PLUGIN_DIR/bin/airplay-write-config"
fi
# Keep a working copy of the uninstaller outside the plugin folder.
#
# `omarchy plugin remove` deletes a git-managed plugin outright, with no
# backup (omarchy-plugin-remove only backs up plugins that are *not* git
# checkouts). So removing the plugin would otherwise take the only tool that
# undoes this setup with it, leaving a running receiver and firewall rules
# with no way to reverse them from the UI.
#
# airplay-remove derives every path from $HOME and references nothing inside
# the plugin folder, so a copy next to the firewall record works standalone.
run "$INSTALL_FILE" --mkdir "$STATE_DIR" 0700
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-remove" "$STATE_DIR/airplay-remove" 0755
# The unit's audio gate lives here too, so the receiver keeps working even if
# the plugin is removed. See the comment in share/omarchy-airplay.service.
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-wait-audio" "$STATE_DIR/airplay-wait-audio" 0755
# airplay-remove sources the rule spec from its own directory, so the copy has
# to travel with it.
run "$INSTALL_FILE" "$PLUGIN_DIR/bin/airplay-firewall-spec" "$STATE_DIR/airplay-firewall-spec" 0644

run "$INSTALL_FILE" --mkdir "$UNIT_DIR" 0755
# Copied verbatim -- the unit resolves the home directory itself with %h, so
# there is nothing to interpolate. Nothing in it is built from an inherited
# value.
run "$INSTALL_FILE" "$PLUGIN_DIR/share/omarchy-airplay.service" \
  "$UNIT_DIR/omarchy-airplay.service" 0644
run systemctl --user daemon-reload
echo

bold "Setup done."
cat <<EOM

The receiver is installed but not started. Turn it on from the plugin popup,
or by hand with:

    systemctl --user start omarchy-airplay

Then look for "$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*;.*/\1/p' \
  "${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync/shairport-sync.conf" 2>/dev/null \
  | head -1)" in the AirPlay list on your phone.

If the speaker appears on the phone but will not connect, the firewall is the
usual reason. Re-run this setup with --wide.

To undo everything later, use "Remove receiver" in the plugin popup. A copy of
the uninstaller also lives outside the plugin folder, so it still works if the
plugin itself is removed first:

    $STATE_DIR/airplay-remove --system
EOM
