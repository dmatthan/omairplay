#!/bin/bash
# Block until the audio server is usable and settled, or give up. The unit's
# ExecStartPre gate.
#
# pipewire-pulse restarts a few seconds into every login, and shairport-sync
# never reconnects its PulseAudio context: started too early, it advertises
# but cannot play. So wait for a real sink and for pipewire-pulse to have been
# up for a while, not merely up. Run it by hand to see what it decides.

set -uo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


TIMEOUT="${1:-45}"
# Longer than the ~5 s restart observed at login.
MIN_STABLE_SEC="${2:-12}"
PULSE_UNIT="pipewire-pulse.service"

if ! command -v pactl >/dev/null 2>&1; then
  # Should not happen (libpulse ships pactl); never block the receiver over it.
  echo "airplay-wait-audio: pactl not found, not waiting" >&2
  exit 0
fi

# At least one sink that is not PipeWire's `auto_null` dummy placeholder.
real_sink_present() {
  local sinks
  sinks="$(pactl list short sinks 2>/dev/null)" || return 1
  [[ -n $sinks ]] || return 1
  awk '$2 != "auto_null" { found = 1 } END { exit found ? 0 : 1 }' <<<"$sinks"
}

# Seconds pipewire-pulse has been continuously active, on monotonic clocks.
pulse_uptime_sec() {
  local mono up
  mono="$(systemctl --user show "$PULSE_UNIT" -p ActiveEnterTimestampMonotonic --value 2>/dev/null)"
  [[ $mono =~ ^[0-9]+$ ]] || return 1
  (( mono > 0 )) || return 1
  [[ "$(systemctl --user is-active "$PULSE_UNIT" 2>/dev/null)" == active ]] || return 1
  up="$(cut -d' ' -f1 /proc/uptime 2>/dev/null)" || return 1
  awk -v up="$up" -v mono="$mono" 'BEGIN { printf "%d", up - (mono / 1000000) }'
}

for (( i = 0; i < TIMEOUT; i++ )); do
  if real_sink_present; then
    stable="$(pulse_uptime_sec)" || stable=""
    if [[ -z $stable ]]; then
      # No usable timestamp; the sink check passed, so do not block.
      echo "airplay-wait-audio: sink ready; $PULSE_UNIT age unknown, continuing"
      exit 0
    fi
    if (( stable >= MIN_STABLE_SEC )); then
      echo "airplay-wait-audio: audio ready after ${i}s (sink: $(pactl get-default-sink 2>/dev/null), $PULSE_UNIT stable ${stable}s)"
      exit 0
    fi
  fi
  sleep 1
done

echo "airplay-wait-audio: audio did not settle within ${TIMEOUT}s" >&2
systemctl --user is-active "$PULSE_UNIT" >&2 2>/dev/null || true
pactl list short sinks >&2 2>/dev/null || true
exit 1
