#!/usr/bin/python3 -I
"""Install one file into a directory without following symlinks.

    airplay-install-file SRC DEST MODE

airplay-setup uses this for the three files it places in the state directory
and for the systemd user unit. All four are later executed or read by something
else: airplay-wait-audio runs as the receiver unit's ExecStartPre,
airplay-remove is run with sudo, and the unit tells systemd what to launch.

The gap this closes is the destination *directory*. `mkdir -p` accepts a
symlink where it expected a directory and exits 0, after which install(1)
writes into whatever that link points at -- so setup can be made to place an
executable somewhere it never named, and the file it meant to install is not
where it will later look for it. This opens the directory O_NOFOLLOW and stops
with a message instead. (install(1) is sound about the final component: it
unlinks an existing symlink rather than writing through it. A non-regular file
at the destination is still refused here, because it means something
unexpected is there.)

The content goes to a temporary file in the destination directory -- never
/tmp, which has no business in installing something that will be executed --
and is moved into place with os.replace, which is atomic. install(1) unlinks
and then copies, so a reader can catch a half-written executable; the unit's
ExecStartPre reads one of these on every start.

This is not a defence against an attacker who already has this user's
privileges: these paths are under $HOME and written as the user, so anyone able
to write them could rewrite them afterwards. The narrower guarantee is the
useful one -- setup writes a regular file to exactly the path it names,
completely, or fails loudly.
"""

import os
import pwd
import secrets
import stat
import sys


def fail(message):
    print(f"airplay-install-file: {message}", file=sys.stderr)
    raise SystemExit(1)


# Anything this installs is small: the largest is the uninstaller at a few
# thousand lines. A cap keeps a substituted file from being read into memory
# without limit.
MAX_SOURCE_BYTES = 1 << 20


def read_regular_file(path):
    """Read a file through a descriptor, refusing anything that is not one.

    open() on a path is three assumptions: that it is not a symlink, that it is
    a regular file, and that reading it will return. A FIFO left at the path
    breaks the third -- the open blocks until someone writes, which stalls
    whatever was reading. O_NONBLOCK makes that open return instead, and fstat
    on the descriptor answers the other two about the thing actually opened
    rather than about whatever the name pointed at a moment ago.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        fail(f"cannot read {path}: {exc.strerror}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            fail(f"{path} is not a regular file; refusing to read it")
        if st.st_size > MAX_SOURCE_BYTES:
            fail(f"{path} is larger than {MAX_SOURCE_BYTES} bytes; refusing to read it")
        # Clear O_NONBLOCK now the type is known: it means nothing for a regular
        # file, and leaving it set would be misleading.
        os.set_blocking(fd, True)
        with os.fdopen(fd, "rb") as fh:
            fd = -1
            return fh.read(MAX_SOURCE_BYTES + 1)[:MAX_SOURCE_BYTES]
    finally:
        if fd >= 0:
            os.close(fd)


def parse_mode(text):
    try:
        return int(text, 8)
    except ValueError:
        fail(f"mode must be octal, got {text!r}")


def real_home():
    """The home directory from the passwd database, not the environment.

    The same source systemd's %h uses, so the scripts and the unit cannot
    disagree about where anything lives.
    """
    return pwd.getpwuid(os.getuid()).pw_dir


def make_dir_under_home(path, mode):
    """Create a directory, component by component, following no symlink.

    `mkdir -p` is one of the "ordinary pathname operations" this file exists to
    replace: it walks the path by name, so a symlink anywhere along it silently
    redirects where the directory ends up -- and everything installed into it
    afterwards. Each component here is created with mkdirat through a retained
    descriptor and reopened O_NOFOLLOW, so a link found on the way is an error
    rather than a redirection.

    The mode is applied to the final component on every run, not only when it
    is created, so a directory left behind by an earlier version is corrected
    rather than kept as it was.
    """
    home = os.path.realpath(real_home())
    target = os.path.abspath(path)
    if target != home and not target.startswith(home + os.sep):
        fail(f"refusing to create a directory outside {home}: {target}")

    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    rest = os.path.relpath(target, home)
    if rest == ".":
        os.close(fd)
        return
    walked = []
    try:
        for part in rest.split(os.sep):
            if part in ("", "."):
                continue
            if part == "..":
                fail(f"refusing a path that climbs out of {home}: {target}")
            try:
                os.mkdir(part, mode, dir_fd=fd)
            except FileExistsError:
                pass
            except OSError as exc:
                fail(f"cannot create {target}: {exc.strerror}")
            try:
                nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                              dir_fd=fd)
            except OSError as exc:
                fail(f"cannot create {target}: {exc.strerror} at "
                     f"{os.path.join(home, *walked, part)}")
            os.close(fd)
            fd = nfd
            walked.append(part)
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def open_dir_under_home(path):
    """Open a directory, refusing a symlink at any component below $HOME.

    Opening the destination O_NOFOLLOW only checks the last component. A
    symlink swapped in higher up -- ~/.local, or ~/.local/state -- redirects
    the write just as effectively, and those are directories this user can
    replace. So each component below the home directory is opened O_NOFOLLOW
    in turn, walking down from a descriptor on the home itself.

    The home directory and everything above it is resolved normally. A
    symlinked /home or a symlinked home directory is a legitimate thing for an
    administrator to arrange, and refusing it would break working systems to
    defend against someone who would already need root to set it up.

    Refusing a destination outside the home directory is deliberate: this
    installer has no business writing anywhere else.
    """
    home = os.path.realpath(real_home())
    # Not realpath: resolving the tail here would quietly follow exactly the
    # symlinks the walk below exists to refuse.
    target = os.path.abspath(path)
    if target != home and not target.startswith(home + os.sep):
        fail(f"refusing to write outside {home}: {target}")

    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    rest = os.path.relpath(target, home)
    if rest == ".":
        return fd
    walked = []
    try:
        for part in rest.split(os.sep):
            if part in ("", "."):
                continue
            if part == "..":
                fail(f"refusing a path that climbs out of {home}: {target}")
            try:
                nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                              dir_fd=fd)
            except OSError as exc:
                fail(f"cannot open {target}: {exc.strerror} at "
                     f"{os.path.join(home, *walked, part)}")
            os.close(fd)
            fd = nfd
            walked.append(part)
    except BaseException:
        os.close(fd)
        raise
    return fd


def main(argv):
    if len(argv) == 3 and argv[0] == "--stdin":
        # Content from a pipe, not a path.
        #
        # This used to be spelled `airplay-install-file /dev/stdin DEST MODE`,
        # which broke the moment the source read started refusing symlinks:
        # /dev/stdin is a symlink to /proc/self/fd/0, and O_NOFOLLOW without
        # O_DIRECTORY reports that as ELOOP. Reading descriptor 0 directly has
        # no path to resolve and so nothing to refuse.
        _, dest, mode_text = argv
        # Descriptor 0 gets the same type question a path would. A terminal or
        # a FIFO with nothing on the other end would block here, which is the
        # same stall a planted FIFO causes on a path read; this is meant to be
        # fed by a pipe, so anything else is a mistake worth failing on.
        st0 = os.fstat(0)
        if not (stat.S_ISFIFO(st0.st_mode) or stat.S_ISREG(st0.st_mode)):
            fail("--stdin expects a pipe or a regular file on standard input")
        data = sys.stdin.buffer.read(MAX_SOURCE_BYTES + 1)
        if len(data) > MAX_SOURCE_BYTES:
            fail(f"input is larger than {MAX_SOURCE_BYTES} bytes; refusing it")
        place(data, dest, parse_mode(mode_text))
        return

    if len(argv) == 3 and argv[0] == "--mkdir":
        _, dest, mode_text = argv
        make_dir_under_home(dest, parse_mode(mode_text))
        print(f"Created {dest}")
        return

    if len(argv) != 3:
        fail("usage: airplay-install-file SRC DEST MODE\n"
             "       airplay-install-file --stdin DEST MODE\n"
             "       airplay-install-file --mkdir DIR MODE")

    src, dest, mode_text = argv
    place(read_regular_file(src), dest, parse_mode(mode_text))


def place(content, dest, mode):
    """Put exactly these bytes at dest, or fail without touching anything."""
    name = os.path.basename(dest)
    if not name or name in (".", ".."):
        fail(f"destination is not a file path: {dest!r}")
    dest_dir = os.path.dirname(dest) or "."

    try:
        dir_fd = open_dir_under_home(dest_dir)
    except OSError as exc:
        fail(f"cannot open directory {dest_dir}: {exc.strerror}")

    # Random, not derived from the pid: a predictable name is one an attacker
    # can create first, and O_EXCL would then fail every run rather than once.
    tmp = f".{name}.tmp.{secrets.token_hex(8)}"
    try:
        try:
            # Anything already there must be a plain file, or replacing it is
            # not the operation we think it is.
            existing = os.lstat(name, dir_fd=dir_fd)
            if not stat.S_ISREG(existing.st_mode):
                fail(f"{dest} exists and is not a regular file; refusing to replace it")
        except FileNotFoundError:
            pass

        try:
            # O_EXCL: a file or symlink sitting at the temporary name is an
            # error, not something to write through.
            #
            # Created 0600, not at the final mode. Between create and rename the
            # file is incomplete, and for the executables this installs that
            # would mean a partially written file briefly carrying the execute
            # bit. The mode is set below, once the content is on disk.
            fd = os.open(
                tmp,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=dir_fd,
            )
            with os.fdopen(fd, "wb") as fh:
                fh.write(content)
                fh.flush()
                os.fsync(fh.fileno())
            # Explicitly, because open()'s mode is masked by the umask and these
            # modes matter.
            os.chmod(tmp, mode, dir_fd=dir_fd, follow_symlinks=False)
            os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        except OSError as exc:
            _discard(tmp, dir_fd)
            fail(f"cannot install {dest}: {exc.strerror}")
        except SystemExit:
            _discard(tmp, dir_fd)
            raise
    finally:
        os.close(dir_fd)

    print(f"Installed {dest}")


def _discard(tmp, dir_fd):
    try:
        os.unlink(tmp, dir_fd=dir_fd)
    except OSError:
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
