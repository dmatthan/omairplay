#!/bin/bash
# Generate the whole shairport-sync config from the settings passed in. Never
# parses hand edits; takes effect when the receiver restarts. User only.
#
# Usage: airplay-write-config [--name NAME] [--backend BACKEND] [--print] [--force]

set -euo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
INSTALL_FILE="$HERE/airplay-install-file"
CONFIG_DIR="$HOME/.config/shairport-sync"
CONFIG_FILE="$CONFIG_DIR/shairport-sync.conf"
CACHE_DIR="$HOME/.cache/shairport-sync"

NAME="Omarchy Speaker"
# The names `shairport-sync -h` prints. PipeWire goes through pipewire-pulse.
BACKEND="pulseaudio"
PRINT_ONLY="no"
FORCE="no"

while (( $# )); do
  case "$1" in
    --name)    NAME="${2:?--name needs a value}"; shift 2 ;;
    --backend) BACKEND="${2:?--backend needs a value}"; shift 2 ;;
    --print)   PRINT_ONLY="yes"; shift ;;
    --force)   FORCE="yes"; shift ;;
    *) echo "airplay-write-config: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

case "$BACKEND" in
  pulseaudio|pipewire|alsa) ;;
  *) echo "airplay-write-config: refusing unknown backend '$BACKEND'" >&2; exit 2 ;;
esac

# libconfig strings take C-style escapes; a quote must not end the string.
escape_libconfig() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Shown in the phone's speaker list; shairport-sync caps it at 50 characters.
# Control characters first: a newline would end the string and let the rest
# land as directives, and libconfig has hooks that run commands. Enforced here,
# not in the caller, since settings and the command line reach this too.
# One capped read that follows no symlink and cannot stall on a FIFO.
read_capped() { dd if="$1" bs="$2" count=1 iflag=nofollow,nonblock status=none 2>/dev/null || true; }
# Cut to at most N bytes without splitting a UTF-8 character (LC_ALL=C counts
# bytes); iconv -c drops a partial one at the end.
utf8_cut() { printf '%s' "${1:0:$2}" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || true; }
NAME="${NAME//[[:cntrl:]]/}"
NAME="$(utf8_cut "$NAME" 50)"
[[ -n ${NAME//[[:space:]]/} ]] || NAME="Omarchy Speaker"

render() {
  cat <<CONF
// omairplay:generated
// omairplay:template 2
// Generated by OmairPlay (io.github.dmatthan.omairplay), an Omarchy plugin.
// Every setting here comes from the plugin's own settings; hand edits are
// overwritten the next time the plugin writes this file. Change the values in
// the plugin popup instead.
//
// Written: $(date -Is)

general = {
  name = "$(escape_libconfig "$NAME")";
  output_backend = "$BACKEND";
  mdns_backend = "avahi";

  // The session bus: the system bus admits only root and the shairport-sync
  // user, and the shell reads MPRIS from the session bus.
  mpris_service_bus = "session";
  dbus_service_bus = "session";
};

// Metadata and cover art, explicitly, so this file says what it does.
metadata = {
  enabled = "yes";
  include_cover_art = "yes";
  // Under \$HOME rather than the default in /tmp.
  cover_art_cache_directory = "$(escape_libconfig "$CACHE_DIR/coverart")";
  // Always created with metadata on, and the default is a world-writable FIFO
  // in /tmp. Nothing reads it; it only has to be private (not in coverart/,
  // which the receiver clears).
  pipe_name = "$(escape_libconfig "$CACHE_DIR/metadata-pipe")";
};

sessioncontrol = {
  // Stop reporting the "active" state promptly once the phone stops.
  active_state_timeout = 10.0;

  // Let a second device take over rather than be told the speaker is busy.
  // This is a sessioncontrol setting, not a general one.
  allow_session_interruption = "yes";
};
CONF
}

if [[ $PRINT_ONLY == yes ]]; then
  render
  exit 0
fi

# Never overwrite a file that is not ours: refuse anything without the
# generated marker line unless --force. -L too, so the guard reads where the
# write lands.
if [[ -f $CONFIG_FILE && ! -L $CONFIG_FILE && $FORCE != yes ]] \
   && ! read_capped "$CONFIG_FILE" 4096 | grep -q '^// omairplay:generated'; then
  cat >&2 <<MSG
airplay-write-config: refusing to overwrite $CONFIG_FILE

That file was not generated by this plugin, and this script replaces the whole
file rather than editing it. Move it somewhere safe first, then run setup again
-- or pass --force if you are certain you want it replaced.
MSG
  exit 3
fi

# Through the installer: mkdir -p would follow a planted symlink.
"$INSTALL_FILE" --mkdir "$CONFIG_DIR" 0700 >/dev/null
"$INSTALL_FILE" --mkdir "$CACHE_DIR" 0700 >/dev/null
"$INSTALL_FILE" --mkdir "$CACHE_DIR/coverart" 0700 >/dev/null
TMP="$(mktemp "$CONFIG_DIR/.shairport-sync.conf.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
render >"$TMP"
chmod 0644 "$TMP"

# Leave an unchanged file alone, or the plugin would claim a restart is owed.
if [[ -f $CONFIG_FILE && ! -L $CONFIG_FILE ]] \
   && diff -q <(grep -v '^// Written:' "$CONFIG_FILE") \
              <(grep -v '^// Written:' "$TMP") >/dev/null 2>&1; then
  rm -f "$TMP"
  trap - EXIT
  echo "$CONFIG_FILE is already up to date"
  exit 0
fi

# Placed with the installer, which refuses a symlink at any component below
# home: where this file lands matters, since its hooks can run commands.
"$INSTALL_FILE" "$TMP" "$CONFIG_FILE" 0644 >/dev/null
rm -f "$TMP"
trap - EXIT

echo "Wrote $CONFIG_FILE"
