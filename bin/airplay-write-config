#!/bin/bash
# Generate the whole shairport-sync config for the AirPlay receiver plugin.
#
# The plugin owns this file end to end and never parses hand edits: every run
# rewrites it from the settings passed in. Changing it takes effect only when
# the receiver restarts, so the caller decides when to do that.
#
# Runs entirely as the user. Touches nothing outside $HOME and needs no root.
#
# Usage: airplay-write-config [--name NAME] [--backend BACKEND] [--print] [--force]

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync"
CONFIG_FILE="$CONFIG_DIR/shairport-sync.conf"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/shairport-sync"

NAME="Omarchy Speaker"
# "pulseaudio", not "pa": those are the names shairport-sync -h actually
# prints. PipeWire output is experimental upstream, so we go through
# pipewire-pulse instead, which is active on this machine.
BACKEND="pulseaudio"
PRINT_ONLY="no"
FORCE="no"

while (( $# )); do
  case "$1" in
    --name)    NAME="${2:?--name needs a value}"; shift 2 ;;
    --backend) BACKEND="${2:?--backend needs a value}"; shift 2 ;;
    --print)   PRINT_ONLY="yes"; shift ;;
    --force)   FORCE="yes"; shift ;;
    *) echo "airplay-write-config: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

case "$BACKEND" in
  pulseaudio|pipewire|alsa) ;;
  *) echo "airplay-write-config: refusing unknown backend '$BACKEND'" >&2; exit 2 ;;
esac

# libconfig strings take C-style escapes, so a name with a quote or a backslash
# would otherwise break the file, or worse, inject a setting.
escape_libconfig() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# The AirPlay name shows up in the iPhone's speaker list. Shairport Sync caps
# the advertised name at 50 characters.
NAME="${NAME:0:50}"
[[ -n ${NAME//[[:space:]]/} ]] || NAME="Omarchy Speaker"

render() {
  cat <<CONF
// omairplay:generated
// Generated by OmairPlay (io.github.dmatthan.omairplay), an Omarchy plugin.
// Every setting here comes from the plugin's own settings; hand edits are
// overwritten the next time the plugin writes this file. Change the values in
// the plugin popup instead.
//
// Written: $(date -Is)

general = {
  name = "$(escape_libconfig "$NAME")";
  output_backend = "$BACKEND";
  mdns_backend = "avahi";

  // MPRIS must be on the session bus, for two separate reasons:
  //
  //  1. /etc/dbus-1/system.d/shairport-sync-mpris.conf only lets the users
  //     "shairport-sync" and "root" own org.mpris.MediaPlayer2.ShairportSync
  //     on the system bus. We run as an ordinary user, so the system bus
  //     would refuse us.
  //  2. Omarchy's own media service reads Quickshell.Services.Mpris, which
  //     enumerates the session bus. On the session bus the receiver shows up
  //     in the media widget for free.
  mpris_service_bus = "session";
  dbus_service_bus = "session";
};

// This build reports "metadata", "dbus" and "mpris", and shairport-sync turns
// "enabled" and "include_cover_art" on by default whenever one of those is
// compiled in. Both are set explicitly anyway so the file says what it does.
metadata = {
  enabled = "yes";
  include_cover_art = "yes";
  // Default is /tmp/shairport-sync/.cache/coverart. Keep it under \$HOME so the
  // receiver writes nothing outside \$HOME, and so the art URL reaching MPRIS
  // stays readable after a tmp clean.
  cover_art_cache_directory = "$(escape_libconfig "$CACHE_DIR/coverart")";
};

sessioncontrol = {
  // Stop reporting the "active" state promptly once the phone stops.
  active_state_timeout = 10.0;

  // Let a second device take over rather than be told the speaker is busy.
  // This is a sessioncontrol setting, not a general one.
  allow_session_interruption = "yes";
};
CONF
}

if [[ $PRINT_ONLY == yes ]]; then
  render
  exit 0
fi

# This path is not one shairport-sync reads by default -- its own default is
# /etc/shairport-sync.conf, and the unit passes ours explicitly with -c. But it
# is a plausible place for someone to have kept a hand-written config, and this
# script overwrites the file wholesale. So refuse to touch anything that is not
# already ours, rather than silently destroying it.
#
# The test is the dedicated `// omairplay:generated` marker line, NOT the
# human-readable header underneath it. Guarding on the prose was the first
# attempt and it immediately rejected our own config, because the wording had
# been changed since that file was written. The marker never changes.
if [[ -f $CONFIG_FILE && $FORCE != yes ]] \
   && ! grep -q '^// omairplay:generated' "$CONFIG_FILE"; then
  cat >&2 <<MSG
airplay-write-config: refusing to overwrite $CONFIG_FILE

That file was not generated by this plugin, and this script replaces the whole
file rather than editing it. Move it somewhere safe first, then run setup again
-- or pass --force if you are certain you want it replaced.
MSG
  exit 3
fi

mkdir -p "$CONFIG_DIR" "$CACHE_DIR/coverart"
TMP="$(mktemp "$CONFIG_DIR/.shairport-sync.conf.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
render >"$TMP"
chmod 0644 "$TMP"

# Leave the file alone when nothing actually changed, ignoring the generated
# timestamp comment. The receiver only reads its config at startup, so
# "was this file written after the receiver started?" is how the plugin decides
# whether a restart is owed -- and rewriting a byte-identical file would make
# it claim a restart is needed when nothing changed at all.
if [[ -f $CONFIG_FILE ]] \
   && diff -q <(grep -v '^// Written:' "$CONFIG_FILE") \
              <(grep -v '^// Written:' "$TMP") >/dev/null 2>&1; then
  rm -f "$TMP"
  trap - EXIT
  echo "$CONFIG_FILE is already up to date"
  exit 0
fi

mv -f "$TMP" "$CONFIG_FILE"
trap - EXIT

echo "Wrote $CONFIG_FILE"
