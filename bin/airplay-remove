#!/bin/bash
# Remove the AirPlay receiver. Everything in $HOME is undone unprivileged; the
# firewall rules and nqptp need root and are only printed unless --system.
# Works from the plugin folder and from setup's copy in ~/.local/state.
# Packages stay installed: something else may want them.
#
# Usage: airplay-remove [--system] [--dry-run]   (--firewall is an old alias)

set -uo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


DO_SYSTEM="no"
DRY_RUN="no"
while (( $# )); do
  case "$1" in
    --system|--firewall) DO_SYSTEM="yes"; shift ;;
    --dry-run)  DRY_RUN="yes"; shift ;;
    *) echo "airplay-remove: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Standalone, the spec may be missing: this literal must match
# OMAIRPLAY_UFW_COMMENT in airplay-firewall-spec.
# shellcheck source=/dev/null
[[ -r "$HERE/airplay-firewall-spec" ]] && source "$HERE/airplay-firewall-spec"
: "${OMAIRPLAY_UFW_COMMENT:=omairplay}"

UNIT="omarchy-airplay.service"
UNIT_PATH="$HOME/.config/systemd/user/$UNIT"
CONFIG_DIR="$HOME/.config/shairport-sync"
CACHE_DIR="$HOME/.cache/shairport-sync"
STATE_DIR="$HOME/.local/state/io.github.dmatthan.omairplay"

# Unfinished work: keeps the state directory and is repeated in the summary.
UNFINISHED=()
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
run() {
  printf '\033[36m$ %s\033[0m\n' "$*"
  [[ $DRY_RUN == yes ]] && return 0
  "$@"
}

bold "Removing the AirPlay receiver"
echo

bold "1. Stop and disable the user service"
if systemctl --user is-active "$UNIT" &>/dev/null; then
  run systemctl --user stop "$UNIT"
else
  echo "$UNIT is not running."
fi
if [[ "$(systemctl --user is-enabled "$UNIT" 2>/dev/null)" == "enabled" ]]; then
  run systemctl --user disable "$UNIT"
else
  echo "$UNIT is not enabled at login."
fi
echo

bold "2. Delete the unit, the generated config and the cover-art cache"
[[ -f $UNIT_PATH ]] && run rm -f "$UNIT_PATH" || echo "No unit file at $UNIT_PATH"
[[ -d $CONFIG_DIR ]] && run rm -rf "$CONFIG_DIR" || echo "No config at $CONFIG_DIR"
[[ -d $CACHE_DIR ]] && run rm -rf "$CACHE_DIR" || echo "No cover-art cache at $CACHE_DIR"
run systemctl --user daemon-reload
echo

bold "3. Firewall"
# Found by tag rather than a saved list, so rules from older versions or old
# prefixes go too. Highest number first, because ufw renumbers.
if ! command -v ufw >/dev/null 2>&1; then
  echo "ufw is not installed; nothing to undo."
elif [[ $DO_SYSTEM != yes ]]; then
  echo "Removing firewall rules needs root, so they have been left in place."
  echo "To see them:"
  echo "    sudo ufw status | grep $OMAIRPLAY_UFW_COMMENT"
  echo "To remove them, re-run:"
  echo "    $SELF --system"
# Into a variable, not a pipe: a pipe hides sudo failing, which looked exactly
# like a firewall with no rules left.
elif [[ $DRY_RUN == yes ]]; then
  # A dry run must not prompt for a password, so it describes this step.
  echo "Would delete rules tagged \"$OMAIRPLAY_UFW_COMMENT\" and reload ufw."
elif ! ufw_status="$(sudo ufw status numbered 2>&1)"; then
  UNFINISHED+=( "firewall rules tagged \"$OMAIRPLAY_UFW_COMMENT\"" )
  warn "Could not read the firewall rules, so none were removed."
  [[ -n $ufw_status ]] && warn "    $ufw_status"
  warn "To see them:    sudo ufw status | grep $OMAIRPLAY_UFW_COMMENT"
  warn "To remove them: $SELF --system"
else
  mapfile -t numbers < <(
    printf '%s\n' "$ufw_status" \
      | grep -F "# $OMAIRPLAY_UFW_COMMENT" \
      | grep -oE '^\[[ 0-9]+\]' | tr -d '[] ' | sort -rn
  )
  if (( ${#numbers[@]} == 0 )); then
    echo "No rules tagged \"$OMAIRPLAY_UFW_COMMENT\" found."
  else
    echo "Removing ${#numbers[@]} rule(s) tagged \"$OMAIRPLAY_UFW_COMMENT\"."
    for n in "${numbers[@]}"; do
      run sudo ufw --force delete "$n" \
        || warn "ufw did not delete rule $n; it may already be gone."
    done
    run sudo ufw reload || warn "ufw reload failed."

    # Confirm rather than assume: deleting by number is position-sensitive.
    if [[ $DRY_RUN != yes ]]; then
      if ! ufw_after="$(sudo ufw status numbered 2>&1)"; then
        UNFINISHED+=( "firewall rules tagged \"$OMAIRPLAY_UFW_COMMENT\" (could not verify)" )
        warn "Could not re-read the firewall to confirm the rules are gone."
      else
        left="$(printf '%s\n' "$ufw_after" | grep -cF "# $OMAIRPLAY_UFW_COMMENT")" || true
        if (( ${left:-0} > 0 )); then
          UNFINISHED+=( "$left firewall rule(s) tagged \"$OMAIRPLAY_UFW_COMMENT\"" )
          warn "$left rule(s) tagged \"$OMAIRPLAY_UFW_COMMENT\" are still present."
          warn "To remove them, re-run: $SELF --system"
        else
          echo "Confirmed: no rules tagged \"$OMAIRPLAY_UFW_COMMENT\" remain."
        fi
      fi
    fi
  fi
fi
echo

bold "4. The nqptp system service"
# Only if setup enabled it, which its ownership note records.
NQPTP_NOTE="$STATE_DIR/enabled-nqptp"
# A real file, not a symlink: a planted link must not make removal disable a
# service setup never enabled.
if [[ ! -f $NQPTP_NOTE || -L $NQPTP_NOTE ]]; then
  echo "nqptp.service was not enabled by this plugin; leaving it alone."
elif [[ "$(systemctl is-enabled nqptp.service 2>/dev/null)" != "enabled" ]] \
     && ! systemctl is-active nqptp.service &>/dev/null; then
  echo "nqptp.service is already off."
  run rm -f "$NQPTP_NOTE"
elif [[ $DO_SYSTEM != yes ]]; then
  echo "Setup enabled nqptp.service. Disabling it needs root, so it has been"
  echo "left running. To undo it:"
  echo "    sudo systemctl disable --now nqptp.service"
else
  echo "Setup enabled nqptp.service, so turning it back off."
  # Keep the note: it is the record that setup enabled this service.
  if run sudo systemctl disable --now nqptp.service; then
    run rm -f "$NQPTP_NOTE"
  else
    UNFINISHED+=( "nqptp.service, still enabled" )
    warn "Could not disable nqptp.service; the note recording that setup"
    warn "enabled it has been kept. To finish:"
    warn "    sudo systemctl disable --now nqptp.service"
  fi
fi
echo

bold "5. Clean up"
# A running script can delete itself (bash holds the inode). Except when system
# work is still pending: the uninstaller and its note are needed to finish it.
if [[ $DO_SYSTEM == yes ]] && (( ${#UNFINISHED[@]} )); then
  echo "Keeping $STATE_DIR: the removal did not finish."
  for item in "${UNFINISHED[@]}"; do
    echo "  - $item"
  done
  echo
  echo "It holds this uninstaller and the rule list it needs. Once the problem"
  echo "is sorted, re-run:"
  echo "    $SELF --system"
elif [[ $DO_SYSTEM == yes ]]; then
  if [[ $DRY_RUN == yes ]]; then
    printf '\033[36m$ %s\033[0m\n' "rm -rf $STATE_DIR"
    echo "Nothing would be left behind."
  else
    rm -rf "$STATE_DIR"
    echo "Removed $STATE_DIR, this uninstaller included. Nothing is left behind."
  fi
else
  echo "Keeping $STATE_DIR for now: it holds this uninstaller, which you still"
  echo "need to undo the firewall rules and the nqptp service."
fi
echo

if (( ${#UNFINISHED[@]} == 1 )); then
  bold "Done, apart from the one thing listed above."
elif (( ${#UNFINISHED[@]} )); then
  bold "Done, apart from the ${#UNFINISHED[@]} things listed above."
else
  bold "Done."
fi
cat <<EOM

The shairport-sync and nqptp packages are still installed. They sit inert, and
may be wanted by something else, so removing them is a separate decision:

    sudo pacman -Rs shairport-sync nqptp
EOM

# A removal that could not finish is not a success.
if (( ${#UNFINISHED[@]} )); then
  exit 1
fi
