#!/bin/bash
# Remove the AirPlay receiver.
#
# Everything here except the firewall is unprivileged, because everything the
# plugin owns lives in $HOME. The ufw rules do need root, so by default this
# only *prints* the commands that delete them and lets Daniel decide; pass
# --firewall to run them, which will ask for a password.
#
# Package removal is deliberately not done here. shairport-sync and nqptp may
# be wanted by something else, and uninstalling them needs its own approval.
#
# Usage: airplay-remove [--firewall] [--dry-run]

set -uo pipefail

DO_FIREWALL="no"
DRY_RUN="no"
while (( $# )); do
  case "$1" in
    --firewall) DO_FIREWALL="yes"; shift ;;
    --dry-run)  DRY_RUN="yes"; shift ;;
    *) echo "airplay-remove: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

UNIT="omarchy-airplay.service"
UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/shairport-sync"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/io.github.dmatthan.omairplay"
MARKER="$STATE_DIR/firewall-configured"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
run() {
  printf '\033[36m$ %s\033[0m\n' "$*"
  [[ $DRY_RUN == yes ]] && return 0
  "$@"
}

bold "Removing the AirPlay receiver"
echo

bold "1. Stop and disable the user service"
if systemctl --user is-active "$UNIT" &>/dev/null; then
  run systemctl --user stop "$UNIT"
else
  echo "$UNIT is not running."
fi
if [[ "$(systemctl --user is-enabled "$UNIT" 2>/dev/null)" == "enabled" ]]; then
  run systemctl --user disable "$UNIT"
else
  echo "$UNIT is not enabled at login."
fi
echo

bold "2. Delete the unit and the generated config"
[[ -f $UNIT_PATH ]] && run rm -f "$UNIT_PATH" || echo "No unit file at $UNIT_PATH"
[[ -d $CONFIG_DIR ]] && run rm -rf "$CONFIG_DIR" || echo "No config at $CONFIG_DIR"
[[ -d $CACHE_DIR ]] && run rm -rf "$CACHE_DIR" || echo "No cover-art cache at $CACHE_DIR"
run systemctl --user daemon-reload
echo

bold "3. Firewall"
if [[ ! -r $MARKER ]]; then
  echo "No record of added rules at $MARKER, so nothing to undo."
else
  mapfile -t DELETES < <(grep -E '^sudo ufw delete ' "$MARKER")
  if (( ${#DELETES[@]} == 0 )); then
    echo "No delete commands recorded in $MARKER."
  elif [[ $DO_FIREWALL == yes ]]; then
    # Each line is matched against exactly the rule shape airplay-setup writes,
    # and the command is then rebuilt from the captured fields. The previous
    # version word-split the line and ran it directly, which meant anything
    # able to write to $MARKER -- a plain file under $HOME -- got to choose a
    # command that runs under sudo. That is the same privilege-escalation shape
    # the safety rules reject pkexec-on-plugin-scripts for, so it does not get
    # a pass just because we wrote the file ourselves.
    ip4='[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}'
    ip6='[0-9a-fA-F:]+/[0-9]{1,3}'
    ports='[0-9]{1,5}(,[0-9]{1,5})*|[0-9]{1,5}:[0-9]{1,5}'
    pattern="^sudo ufw delete allow from (${ip4}|${ip6}) to any port (${ports}) proto (tcp|udp)\$"

    skipped=0
    for cmd in "${DELETES[@]}"; do
      if [[ ! $cmd =~ $pattern ]]; then
        warn "Refusing to run an unrecognised line from $MARKER:"
        warn "    $cmd"
        skipped=$((skipped + 1))
        continue
      fi
      src="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[3]}"
      proto="${BASH_REMATCH[5]}"
      run sudo ufw delete allow from "$src" to any port "$port" proto "$proto"
    done

    if (( skipped > 0 )); then
      warn "$skipped line(s) were left alone. Check them by hand:"
      warn "    $MARKER"
    elif [[ $DRY_RUN != yes ]]; then
      rm -f "$MARKER"
    fi
  else
    echo "These rules were added for AirPlay. Removing them needs root, so"
    echo "they have been left in place. To remove them:"
    echo
    printf '    %s\n' "${DELETES[@]}"
    echo
    echo "Or re-run:  airplay-remove --firewall"
  fi
fi
echo

bold "Done."
cat <<'EOM'

The packages are still installed. shairport-sync and nqptp may be wanted by
something else, so removing them is a separate decision:

    sudo pacman -Rs shairport-sync nqptp
    sudo systemctl disable --now nqptp.service
EOM
