#!/bin/bash
# Remove the AirPlay receiver.
#
# Everything inside $HOME is undone unprivileged. Setup also made two changes
# that need root to reverse -- the firewall rules, and enabling the nqptp system
# service -- so by default this only prints those; pass --system to undo them.
#
# Designed to work from two places: inside the plugin folder, and from
# ~/.local/state/<id>/, where setup keeps a copy so that removing the plugin
# does not take the uninstaller with it.
#
# Package removal is deliberately not done here. shairport-sync and nqptp may
# be wanted by something else, and uninstalling them needs its own decision.
#
# Usage: airplay-remove [--system] [--dry-run]
#
# --firewall is accepted as an older name for --system.

set -uo pipefail

DO_SYSTEM="no"
DRY_RUN="no"
while (( $# )); do
  case "$1" in
    --system|--firewall) DO_SYSTEM="yes"; shift ;;
    --dry-run)  DRY_RUN="yes"; shift ;;
    *) echo "airplay-remove: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# The spec is the source of truth for the tag when it is available. When this
# script is running standalone it may not be, so fall back to the literal —
# this must stay in step with OMAIRPLAY_UFW_COMMENT in airplay-firewall-spec.
# shellcheck source=/dev/null
[[ -r "$HERE/airplay-firewall-spec" ]] && source "$HERE/airplay-firewall-spec"
: "${OMAIRPLAY_UFW_COMMENT:=omairplay}"

UNIT="omarchy-airplay.service"
UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/shairport-sync"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/io.github.dmatthan.omairplay"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
run() {
  printf '\033[36m$ %s\033[0m\n' "$*"
  [[ $DRY_RUN == yes ]] && return 0
  "$@"
}

bold "Removing the AirPlay receiver"
echo

bold "1. Stop and disable the user service"
if systemctl --user is-active "$UNIT" &>/dev/null; then
  run systemctl --user stop "$UNIT"
else
  echo "$UNIT is not running."
fi
if [[ "$(systemctl --user is-enabled "$UNIT" 2>/dev/null)" == "enabled" ]]; then
  run systemctl --user disable "$UNIT"
else
  echo "$UNIT is not enabled at login."
fi
echo

bold "2. Delete the unit, the generated config and the cover-art cache"
[[ -f $UNIT_PATH ]] && run rm -f "$UNIT_PATH" || echo "No unit file at $UNIT_PATH"
[[ -d $CONFIG_DIR ]] && run rm -rf "$CONFIG_DIR" || echo "No config at $CONFIG_DIR"
[[ -d $CACHE_DIR ]] && run rm -rf "$CACHE_DIR" || echo "No cover-art cache at $CACHE_DIR"
run systemctl --user daemon-reload
echo

bold "3. Firewall"
# Every rule this plugin adds carries the comment tag, so removal works by
# finding the tag rather than by remembering what was added. That is exhaustive
# in a way a saved list never was: it also catches rules left behind by an
# earlier version, or for a network prefix the machine no longer has.
#
# Deleted highest-numbered first, because ufw renumbers as rules are removed.
if ! command -v ufw >/dev/null 2>&1; then
  echo "ufw is not installed; nothing to undo."
elif [[ $DO_SYSTEM != yes ]]; then
  echo "Removing firewall rules needs root, so they have been left in place."
  echo "To see them:"
  echo "    sudo ufw status | grep $OMAIRPLAY_UFW_COMMENT"
  echo "To remove them, re-run:"
  echo "    $(readlink -f "${BASH_SOURCE[0]}") --system"
else
  mapfile -t numbers < <(
    sudo ufw status numbered 2>/dev/null \
      | grep -F "# $OMAIRPLAY_UFW_COMMENT" \
      | grep -oE '^\[[ 0-9]+\]' | tr -d '[] ' | sort -rn
  )
  if (( ${#numbers[@]} == 0 )); then
    echo "No rules tagged \"$OMAIRPLAY_UFW_COMMENT\" found."
  else
    echo "Removing ${#numbers[@]} rule(s) tagged \"$OMAIRPLAY_UFW_COMMENT\"."
    for n in "${numbers[@]}"; do
      run sudo ufw --force delete "$n" || warn "Rule $n was already gone."
    done
    run sudo ufw reload
  fi
fi
echo

bold "4. The nqptp system service"
# Undo this only if setup is the thing that enabled it. Setup leaves a note
# saying so; without that note the service was already enabled before this
# plugin arrived, and turning it off would be breaking something that was not
# ours. That is why there is no prompt here: ownership is recorded, so there is
# nothing for the user to be asked.
NQPTP_NOTE="$STATE_DIR/enabled-nqptp"
if [[ ! -f $NQPTP_NOTE ]]; then
  echo "nqptp.service was not enabled by this plugin; leaving it alone."
elif [[ "$(systemctl is-enabled nqptp.service 2>/dev/null)" != "enabled" ]] \
     && ! systemctl is-active nqptp.service &>/dev/null; then
  echo "nqptp.service is already off."
  run rm -f "$NQPTP_NOTE"
elif [[ $DO_SYSTEM != yes ]]; then
  echo "Setup enabled nqptp.service. Disabling it needs root, so it has been"
  echo "left running. To undo it:"
  echo "    sudo systemctl disable --now nqptp.service"
else
  echo "Setup enabled nqptp.service, so turning it back off."
  run sudo systemctl disable --now nqptp.service
  run rm -f "$NQPTP_NOTE"
fi
echo

bold "5. Leftover files"
for f in "$STATE_DIR/airplay-wait-audio" "$STATE_DIR/airplay-firewall-spec" \
         "$STATE_DIR/firewall-configured" "$STATE_DIR/enabled-nqptp"; do
  [[ -e $f ]] && run rm -f "$f"
done
# Deliberately not deleting this script when it is the copy being run.
echo "The uninstaller itself is left at $STATE_DIR; delete it when you are done."
echo

bold "Done."
cat <<EOM

The shairport-sync and nqptp packages are still installed. They sit inert, and
may be wanted by something else, so removing them is a separate decision:

    sudo pacman -Rs shairport-sync nqptp
EOM
