#!/bin/bash
# Report the receiver's state as JSON on stdout. Unprivileged and read-only.
#
# One process per refresh rather than six: the widget polls this on a timer,
# and a bar widget should not fork a handful of processes every few seconds.

set -uo pipefail

# Re-exec once with a closed environment.
#
# Pinning PATH was not enough. bash reads BASH_ENV for every non-interactive
# script and sources it before the first line here runs, so a hostile value
# executes arbitrary code in this shell -- including defining a function named
# `sudo`, which would then shadow the real command in the privileged steps.
# Unsetting it here cannot help: by then it has already been sourced. The only
# fix is to start again in an environment we built ourselves.
#
# env -i drops everything; what follows is the complete allowlist. It closes
# BASH_ENV and ENV (shell), PYTHONPATH and PYTHONHOME (our python3 helpers),
# LD_PRELOAD and friends (every dynamically linked binary), and CDPATH, IFS and
# GLOBIGNORE (word splitting and `cd`).
#
# The gate is a leading argument, not an environment variable: anything able to
# set a variable could otherwise set the marker and skip the re-exec.
#
# HOME comes from the passwd database rather than the environment. The systemd
# unit resolves its paths with %h, which is the passwd home, so taking it from
# anywhere else let the two disagree -- a user with XDG_CONFIG_HOME set had the
# config written where the receiver would never read it. XDG_* is deliberately
# not carried through, so every path is the one the README documents.
#
# OMARCHY_PATH is set to the value the omarchy package itself hardcodes rather
# than inherited, for the same reason PATH is not inherited.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


UNIT="omarchy-airplay.service"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync/shairport-sync.conf"
UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"

bool() { [[ $1 == 0 ]] && printf 'true' || printf 'false'; }

command -v shairport-sync >/dev/null; BINARY=$?
[[ -f $UNIT_PATH ]]; UNIT_FILE=$?
[[ -f $CONFIG ]]; CONFIG_FILE=$?

ACTIVE="$(systemctl --user is-active "$UNIT" 2>/dev/null)"
UNITFILE="$(systemctl --user is-enabled "$UNIT" 2>/dev/null)"

# Safety rule 4: anything else holding the AirPlay 2 slot is a conflict, and
# there are two candidates -- the packaged system unit and the packaged *user*
# unit, whose preset is "enabled".
SYS=false
systemctl is-active shairport-sync.service &>/dev/null && SYS=true
systemctl is-enabled shairport-sync.service &>/dev/null && SYS=true
PKG=false
systemctl --user is-active shairport-sync.service &>/dev/null && PKG=true
systemctl --user is-enabled shairport-sync.service &>/dev/null && PKG=true

# The clock-sync service AirPlay 2 needs. It is a *system* service, so a plain
# `systemctl is-active` reads it; asking needs no privilege. The unit asserts
# it at start, but it can stop later without the receiver noticing, and then
# the speaker is visible and silent.
NQPTP=false
systemctl is-active nqptp.service &>/dev/null && NQPTP=true

# Whether the receiver is actually accepting connections. shairport-sync in a
# dead audio context keeps running and tears down its listeners while still
# advertising over mDNS -- the state that looks ready and plays nothing. So
# the popup can tell "active" from "usable" by looking at the listener.
#
# Read /proc/net/tcp{,6} directly: no new command to trust, no new privilege,
# and it is the same net namespace the receiver runs in. Port 7000 is 0x1B58,
# state 0A is LISTEN.
LISTENING=false
if [[ $ACTIVE == active ]]; then
  LISTENING="$(python3 -I -c '
for path in ("/proc/net/tcp", "/proc/net/tcp6"):
    try:
        fh = open(path)
    except OSError:
        continue
    with fh:
        next(fh, None)
        for line in fh:
            f = line.split()
            if len(f) > 3 and f[3] == "0A" and int(f[1].split(":")[1], 16) == 7000:
                print("true")
                raise SystemExit
print("false")
')"
fi

# The name the receiver is actually advertising, read back from the generated
# config rather than from the plugin's settings -- so the popup can tell the
# difference between "you typed a new name" and "the receiver has that name".
NAME=""
# -f and not -L, not -r. A FIFO is readable, and sed on one blocks until
# something writes to it -- which turns this probe into a process that never
# returns. The read is also capped: this only needs the first name line, and a
# substituted file should not be streamed into memory. The deadline the caller
# applies would eventually kill a blocked probe, but not returning at all is
# still the wrong behaviour for something that runs every few seconds.
if [[ -f $CONFIG && ! -L $CONFIG ]]; then
  NAME="$(head -c 65536 "$CONFIG" \
    | sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*;.*/\1/p' \
    | head -1)"
  # Undo the libconfig escaping airplay-write-config applies.
  NAME="${NAME//\\\"/\"}"
  NAME="${NAME//\\\\/\\}"
  # Cap it. shairport-sync itself advertises at most 50 characters, and the
  # popup shows fewer, but this is read out of a file the user can edit by
  # hand -- so the field is bounded here rather than left to whatever is in
  # the config. Keeps this program's output bounded by construction: fixed
  # keys, one short variable string, no unbounded field anywhere.
  NAME="${NAME:0:64}"
fi

# The config is only read at startup, so a config written *after* the receiver
# started is a name (or backend) change that has not taken effect yet. Without
# this the popup would happily show the new name while the receiver kept
# broadcasting the old one -- which is a genuinely confusing state to be in.
STALE=false
if [[ -f $CONFIG ]] && [[ $ACTIVE == active ]]; then
  STARTED="$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value 2>/dev/null)"
  if [[ -n $STARTED ]]; then
    STARTED_EPOCH="$(date -d "$STARTED" +%s 2>/dev/null)"
    CONFIG_EPOCH="$(stat -c %Y "$CONFIG" 2>/dev/null)"
    if [[ -n $STARTED_EPOCH && -n $CONFIG_EPOCH ]] \
       && (( CONFIG_EPOCH > STARTED_EPOCH )); then
      STALE=true
    fi
  fi
fi

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

printf '{'
printf '"binary":%s,' "$(bool $BINARY)"
printf '"unit":%s,' "$(bool $UNIT_FILE)"
printf '"config":%s,' "$(bool $CONFIG_FILE)"
printf '"active":"%s",' "$(json_escape "${ACTIVE:-unknown}")"
printf '"unit_file":"%s",' "$(json_escape "${UNITFILE:-unknown}")"
printf '"system_unit_busy":%s,' "$SYS"
printf '"packaged_unit_busy":%s,' "$PKG"
printf '"nqptp":%s,' "$NQPTP"
printf '"listening":%s,' "$LISTENING"
printf '"advertised_name":"%s",' "$(json_escape "$NAME")"
printf '"config_stale":%s' "$STALE"
printf '}\n'
