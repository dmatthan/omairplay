#!/bin/bash
# Report the receiver's state as JSON on stdout. Unprivileged and read-only;
# one process per poll.

set -uo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


UNIT="omarchy-airplay.service"
CONFIG="$HOME/.config/shairport-sync/shairport-sync.conf"
UNIT_PATH="$HOME/.config/systemd/user/$UNIT"

bool() { [[ $1 == 0 ]] && printf 'true' || printf 'false'; }

command -v shairport-sync >/dev/null; BINARY=$?
[[ -f $UNIT_PATH ]]; UNIT_FILE=$?
[[ -f $CONFIG ]]; CONFIG_FILE=$?

# One `systemctl show` per bus; it prints properties in its own order, so
# they are read by key.
declare -A P=()
read_units() {
  local prefix="$1" n=0 line
  while IFS= read -r line; do
    if [[ -z $line ]]; then n=$((n + 1)); continue; fi
    P[$prefix$n.${line%%=*}]="${line#*=}"
  done
}
PROPS=LoadState,ActiveState,UnitFileState,ActiveEnterTimestamp
read_units user < <(systemctl --user show "$UNIT" shairport-sync.service \
  -p "$PROPS" --timestamp=unix 2>/dev/null)
read_units sys < <(systemctl show shairport-sync.service nqptp.service \
  -p "$PROPS" --timestamp=unix 2>/dev/null)

# The exit-status meaning of is-active and is-enabled, from systemctl(1).
is_active() { [[ $1 == active || $1 == reloading || $1 == refreshing ]]; }
is_enabled() {
  case "$1" in
    enabled|enabled-runtime|static|indirect|alias|generated|transient) return 0 ;;
    *) return 1 ;;
  esac
}

ACTIVE="${P[user0.ActiveState]:-}"
UNITFILE="${P[user0.UnitFileState]:-}"
# is-enabled printed not-found for a missing unit; show leaves it empty.
[[ -z $UNITFILE && ${P[user0.LoadState]:-} == not-found ]] && UNITFILE=not-found

# Another receiver holding the AirPlay 2 slot: the packaged system or user unit.
SYS=false
is_active "${P[sys0.ActiveState]:-}" && SYS=true
is_enabled "${P[sys0.UnitFileState]:-}" && SYS=true
PKG=false
is_active "${P[user1.ActiveState]:-}" && PKG=true
is_enabled "${P[user1.UnitFileState]:-}" && PKG=true

# The clock-sync service AirPlay 2 needs. It can stop after the receiver
# started, leaving the speaker visible and silent.
NQPTP=false
is_active "${P[sys1.ActiveState]:-}" && NQPTP=true

# Whether the receiver accepts connections: in a dead audio context it keeps
# advertising with no listener. Port 7000 is 0x1B58, LISTEN is 0A.
listening_on() {
  local wanted="$1" file local_addr state port
  for file in /proc/net/tcp /proc/net/tcp6; do
    [[ -r $file ]] || continue
    while read -r _ local_addr _ state _; do
      [[ $state == 0A ]] || continue
      port="${local_addr##*:}"
      (( 16#$port == wanted )) && return 0
    done < "$file"
  done
  return 1
}

LISTENING=false
if [[ $ACTIVE == active ]] && listening_on 7000; then
  LISTENING=true
fi

# The name the receiver actually advertises, read back from its config.
NAME=""
# -f and not -L: a FIFO would block the read forever. Capped as well.
if [[ -f $CONFIG && ! -L $CONFIG ]]; then
  NAME="$(head -c 65536 "$CONFIG" \
    | sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*;.*/\1/p' \
    | head -1)"
  # Undo the libconfig escaping airplay-write-config applies.
  NAME="${NAME//\\\"/\"}"
  NAME="${NAME//\\\\/\\}"
  # Bounded: the file is hand-editable, and the output stays bounded.
  NAME="${NAME:0:64}"
fi

# The config is read only at startup, so one written since is not live yet.
STALE=false
if [[ -f $CONFIG ]] && [[ $ACTIVE == active ]]; then
  # Already fetched above, as @<epoch> by --timestamp=unix.
  STARTED_EPOCH="${P[user0.ActiveEnterTimestamp]:-}"
  STARTED_EPOCH="${STARTED_EPOCH#@}"
  if [[ $STARTED_EPOCH =~ ^[0-9]+$ ]]; then
    CONFIG_EPOCH="$(stat -c %Y "$CONFIG" 2>/dev/null)"
    if [[ $CONFIG_EPOCH =~ ^[0-9]+$ ]] \
       && (( CONFIG_EPOCH > STARTED_EPOCH )); then
      STALE=true
    fi
  fi
fi

# In bash rather than a sed pipe per field.
json_escape() { local s="${1//\\/\\\\}"; printf '%s' "${s//\"/\\\"}"; }

printf '{'
printf '"binary":%s,' "$(bool $BINARY)"
printf '"unit":%s,' "$(bool $UNIT_FILE)"
printf '"config":%s,' "$(bool $CONFIG_FILE)"
printf '"active":"%s",' "$(json_escape "${ACTIVE:-unknown}")"
printf '"unit_file":"%s",' "$(json_escape "${UNITFILE:-unknown}")"
printf '"system_unit_busy":%s,' "$SYS"
printf '"packaged_unit_busy":%s,' "$PKG"
printf '"nqptp":%s,' "$NQPTP"
printf '"listening":%s,' "$LISTENING"
printf '"advertised_name":"%s",' "$(json_escape "$NAME")"
printf '"config_stale":%s' "$STALE"
printf '}\n'
