#!/bin/bash
# Report whether the firewall currently allows AirPlay, as JSON on stdout.
#
# Needs no root: /etc/ufw/user.rules and user6.rules are world-readable, so the
# plugin can compare the rules that are actually present against the ones the
# shared spec says should exist.
#
# Exit status is always 0 when the JSON is valid; read "ok" for the verdict.

set -uo pipefail

HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/airplay-firewall-spec"

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_array() {
  local first=1 item
  printf '['
  for item in "$@"; do
    (( first )) || printf ','
    first=0
    printf '"%s"' "$(json_escape "$item")"
  done
  printf ']'
}

UFW_PRESENT=false; command -v ufw >/dev/null && UFW_PRESENT=true
UFW_ENABLED=false
[[ -r /etc/ufw/ufw.conf ]] && grep -qE '^ENABLED=yes' /etc/ufw/ufw.conf && UFW_ENABLED=true
UFW_IPV6=false
[[ -r /etc/default/ufw ]] && grep -qE '^IPV6=yes' /etc/default/ufw && UFW_IPV6=true

# IPv4 rules land in user.rules, IPv6 in user6.rules; both world-readable. The
# match deliberately ignores anything after "in", so it works whether or not
# the rule carries a `comment=` tag.
rule_present() {
  local proto="$1" port="$2" src="$3" file
  if [[ $src == *:* ]]; then file=/etc/ufw/user6.rules; else file=/etc/ufw/user.rules; fi
  [[ -r $file ]] || return 1
  local src_re port_re
  src_re="$(printf '%s' "$src" | sed -e 's/[].[^$*\\]/\\&/g')"
  port_re="$(printf '%s' "$port" | sed -e 's/[].[^$*\\]/\\&/g')"
  grep -qE "^### tuple ### allow ${proto} ${port_re} [^ ]+ any ${src_re} in" "$file"
}

mapfile -t GLOBAL_V6 < <(omairplay_global_v6_prefixes)
[[ $UFW_IPV6 == true ]] || GLOBAL_V6=()

MISSING=()
while IFS='|' read -r cidr port proto; do
  [[ -n $cidr ]] || continue
  # Skip IPv6 rules entirely when ufw has IPv6 turned off; they would be
  # accepted and then ignored.
  [[ $cidr == *:* && $UFW_IPV6 != true ]] && continue
  rule_present "$proto" "$port" "$cidr" \
    || MISSING+=( "allow from $cidr to any port $port proto $proto" )
done < <(omairplay_rules yes ${GLOBAL_V6+"${GLOBAL_V6[@]}"})

# "ok" means "no reason to warn", not "everything was verified". A firewall
# that is off blocks nothing.
OK=false
if [[ $UFW_PRESENT == false || $UFW_ENABLED == false ]]; then
  OK=true
elif (( ${#MISSING[@]} == 0 )); then
  OK=true
fi

REASON=""
[[ $OK == false ]] && REASON="${#MISSING[@]} firewall rule(s) missing"

printf '{'
printf '"ok":%s,' "$OK"
printf '"ufw_present":%s,' "$UFW_PRESENT"
printf '"ufw_enabled":%s,' "$UFW_ENABLED"
printf '"ufw_ipv6":%s,' "$UFW_IPV6"
printf '"global_v6":%s,' "$(json_array ${GLOBAL_V6+"${GLOBAL_V6[@]}"})"
printf '"missing":%s,' "$(json_array ${MISSING+"${MISSING[@]}"})"
printf '"reason":"%s"' "$(json_escape "$REASON")"
printf '}\n'
