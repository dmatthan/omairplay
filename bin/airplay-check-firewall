#!/bin/bash
# Report whether the firewall allows AirPlay, as JSON on stdout. No root: the
# ufw rule files are world-readable. Exit 0 whenever the JSON is valid.

set -uo pipefail

# Re-exec once in an environment built here: bash has already sourced BASH_ENV
# by the first line, and LD_PRELOAD and friends reach every binary. The gate is
# an argument, not a variable, so it cannot be set from outside. HOME comes
# from passwd to match the unit's %h; XDG_* is never carried through.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/airplay-firewall-spec"

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_array() {
  local first=1 item
  printf '['
  for item in "$@"; do
    (( first )) || printf ','
    first=0
    printf '"%s"' "$(json_escape "$item")"
  done
  printf ']'
}

UFW_PRESENT=false; command -v ufw >/dev/null && UFW_PRESENT=true
UFW_ENABLED=false
[[ -r /etc/ufw/ufw.conf ]] && grep -qE '^ENABLED=yes' /etc/ufw/ufw.conf && UFW_ENABLED=true
UFW_IPV6=false
[[ -r /etc/default/ufw ]] && grep -qE '^IPV6=yes' /etc/default/ufw && UFW_IPV6=true

# Matches with or without the rule's comment tag.
rule_present() {
  local proto="$1" port="$2" src="$3" file
  if [[ $src == *:* ]]; then file=/etc/ufw/user6.rules; else file=/etc/ufw/user.rules; fi
  [[ -r $file ]] || return 1
  local src_re port_re
  src_re="$(printf '%s' "$src" | sed -e 's/[].[^$*\\]/\\&/g')"
  port_re="$(printf '%s' "$port" | sed -e 's/[].[^$*\\]/\\&/g')"
  grep -qE "^### tuple ### allow ${proto} ${port_re} [^ ]+ any ${src_re} in" "$file"
}

mapfile -t GLOBAL_V6 < <(omairplay_global_v6_prefixes)
[[ $UFW_IPV6 == true ]] || GLOBAL_V6=()
# Bounded, so the output and the rules derived from it stay bounded.
GLOBAL_V6=( ${GLOBAL_V6+"${GLOBAL_V6[@]:0:8}"} )

MISSING=()
while IFS='|' read -r cidr port proto; do
  [[ -n $cidr ]] || continue
  # ufw with IPv6 off would accept these rules and ignore them.
  [[ $cidr == *:* && $UFW_IPV6 != true ]] && continue
  rule_present "$proto" "$port" "$cidr" \
    || MISSING+=( "allow from $cidr to any port $port proto $proto" )
done < <(omairplay_rules yes ${GLOBAL_V6+"${GLOBAL_V6[@]}"})

# ufw with IPv6 off filters nothing on IPv6, so there is nothing to warn about.
# "ok" means no reason to warn, not that everything was verified.
OK=false
REASON=""
if [[ $UFW_PRESENT == false || $UFW_ENABLED == false ]]; then
  OK=true
elif (( ${#MISSING[@]} )); then
  REASON="${#MISSING[@]} firewall rule(s) missing"
else
  OK=true
fi

printf '{'
printf '"ok":%s,' "$OK"
printf '"ufw_present":%s,' "$UFW_PRESENT"
printf '"ufw_enabled":%s,' "$UFW_ENABLED"
printf '"ufw_ipv6":%s,' "$UFW_IPV6"
printf '"global_v6":%s,' "$(json_array ${GLOBAL_V6+"${GLOBAL_V6[@]}"})"
printf '"missing":%s,' "$(json_array ${MISSING+"${MISSING[@]}"})"
printf '"reason":"%s"' "$(json_escape "$REASON")"
printf '}\n'
