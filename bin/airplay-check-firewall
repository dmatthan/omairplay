#!/bin/bash
# Report whether the firewall currently allows AirPlay, as JSON on stdout.
#
# Needs no root: /etc/ufw/user.rules and user6.rules are world-readable, so the
# plugin can compare the rules that are actually present against the ones the
# shared spec says should exist.
#
# Exit status is always 0 when the JSON is valid; read "ok" for the verdict.

set -uo pipefail

# Re-exec once with a closed environment.
#
# Pinning PATH was not enough. bash reads BASH_ENV for every non-interactive
# script and sources it before the first line here runs, so a hostile value
# executes arbitrary code in this shell -- including defining a function named
# `sudo`, which would then shadow the real command in the privileged steps.
# Unsetting it here cannot help: by then it has already been sourced. The only
# fix is to start again in an environment we built ourselves.
#
# env -i drops everything; what follows is the complete allowlist. It closes
# BASH_ENV and ENV (shell), PYTHONPATH and PYTHONHOME (our python3 helpers),
# LD_PRELOAD and friends (every dynamically linked binary), and CDPATH, IFS and
# GLOBIGNORE (word splitting and `cd`).
#
# The gate is a leading argument, not an environment variable: anything able to
# set a variable could otherwise set the marker and skip the re-exec.
#
# HOME comes from the passwd database rather than the environment. The systemd
# unit resolves its paths with %h, which is the passwd home, so taking it from
# anywhere else let the two disagree -- a user with XDG_CONFIG_HOME set had the
# config written where the receiver would never read it. XDG_* is deliberately
# not carried through, so every path is the one the README documents.
#
# OMARCHY_PATH is set to the value the omarchy package itself hardcodes rather
# than inherited, for the same reason PATH is not inherited.
if [[ ${1:-} != --omairplay-sealed-env ]]; then
  _oa_user="$(/usr/bin/id -un)"
  _oa_home="$(/usr/bin/getent passwd "$(/usr/bin/id -u)" | /usr/bin/cut -d: -f6)"
  _oa_env=(
    PATH=/usr/bin
    OMARCHY_PATH=/usr/share/omarchy
    LC_ALL=C
    "HOME=$_oa_home"
    "USER=$_oa_user"
    "LOGNAME=$_oa_user"
  )
  # Needed by `systemctl --user` and by pactl to find the audio socket.
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    _oa_env+=( "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
  fi
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    _oa_env+=( "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
  fi
  # Only so the setup and removal terminals render correctly.
  if [[ -n ${TERM:-} ]]; then
    _oa_env+=( "TERM=$TERM" )
  fi
  exec /usr/bin/env -i "${_oa_env[@]}" /usr/bin/bash "$0" --omairplay-sealed-env "$@"
fi
shift


HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/airplay-firewall-spec"

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_array() {
  local first=1 item
  printf '['
  for item in "$@"; do
    (( first )) || printf ','
    first=0
    printf '"%s"' "$(json_escape "$item")"
  done
  printf ']'
}

UFW_PRESENT=false; command -v ufw >/dev/null && UFW_PRESENT=true
UFW_ENABLED=false
[[ -r /etc/ufw/ufw.conf ]] && grep -qE '^ENABLED=yes' /etc/ufw/ufw.conf && UFW_ENABLED=true
UFW_IPV6=false
[[ -r /etc/default/ufw ]] && grep -qE '^IPV6=yes' /etc/default/ufw && UFW_IPV6=true

# IPv4 rules land in user.rules, IPv6 in user6.rules; both world-readable. The
# match deliberately ignores anything after "in", so it works whether or not
# the rule carries a `comment=` tag.
rule_present() {
  local proto="$1" port="$2" src="$3" file
  if [[ $src == *:* ]]; then file=/etc/ufw/user6.rules; else file=/etc/ufw/user.rules; fi
  [[ -r $file ]] || return 1
  local src_re port_re
  src_re="$(printf '%s' "$src" | sed -e 's/[].[^$*\\]/\\&/g')"
  port_re="$(printf '%s' "$port" | sed -e 's/[].[^$*\\]/\\&/g')"
  grep -qE "^### tuple ### allow ${proto} ${port_re} [^ ]+ any ${src_re} in" "$file"
}

mapfile -t GLOBAL_V6 < <(omairplay_global_v6_prefixes)
[[ $UFW_IPV6 == true ]] || GLOBAL_V6=()
# Bound the list. A machine with a pathological number of global IPv6 prefixes
# would otherwise make this program's output -- and the rule set derived from
# it below -- grow without limit. Eight is far more than a home router hands
# out, and it keeps the JSON bounded by construction, which is what lets the
# caller read it without a byte cap.
GLOBAL_V6=( ${GLOBAL_V6+"${GLOBAL_V6[@]:0:8}"} )

MISSING=()
while IFS='|' read -r cidr port proto; do
  [[ -n $cidr ]] || continue
  # Skip IPv6 rules entirely when ufw has IPv6 turned off; they would be
  # accepted and then ignored.
  [[ $cidr == *:* && $UFW_IPV6 != true ]] && continue
  rule_present "$proto" "$port" "$cidr" \
    || MISSING+=( "allow from $cidr to any port $port proto $proto" )
done < <(omairplay_rules yes ${GLOBAL_V6+"${GLOBAL_V6[@]}"})

# "ok" means "no reason to warn", not "everything was verified". A firewall
# that is off blocks nothing.
OK=false
if [[ $UFW_PRESENT == false || $UFW_ENABLED == false ]]; then
  OK=true
elif (( ${#MISSING[@]} == 0 )); then
  OK=true
fi

REASON=""
[[ $OK == false ]] && REASON="${#MISSING[@]} firewall rule(s) missing"

printf '{'
printf '"ok":%s,' "$OK"
printf '"ufw_present":%s,' "$UFW_PRESENT"
printf '"ufw_enabled":%s,' "$UFW_ENABLED"
printf '"ufw_ipv6":%s,' "$UFW_IPV6"
printf '"global_v6":%s,' "$(json_array ${GLOBAL_V6+"${GLOBAL_V6[@]}"})"
printf '"missing":%s,' "$(json_array ${MISSING+"${MISSING[@]}"})"
printf '"reason":"%s"' "$(json_escape "$REASON")"
printf '}\n'
